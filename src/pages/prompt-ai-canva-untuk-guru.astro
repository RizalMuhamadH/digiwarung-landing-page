---
import Layout from "@/layouts/Layout.astro";
import Hero8 from "@/components/template-8/Hero8.astro";
import Problem8 from "@/components/template-8/Problem8.astro";
import Solution8 from "@/components/template-8/Solution8.astro";
import Features8 from "@/components/template-8/Features8.astro";
import Audience8 from "@/components/template-8/Audience8.astro";
import Pricing8 from "@/components/template-8/Pricing8.astro";
import { Sparkles } from "@lucide/astro";
---

<Layout
  title="PROMPT AI CANVA CODE - Senjata Rahasia Guru Kreatif"
  description="Dapatkan 100+ Prompt AI siap pakai untuk Canva. Bikin materi belajar interaktif, kuis seru, dan media ajar menarik dalam hitungan menit!"
>
  <div class="template-8-root">
    <!-- Header -->
    <header class="header-nav">
      <div class="container">
        <a href="#" class="logo">
          <Sparkles class="logo-icon" />
          <span>PROMPT AI <strong>CANVA CODE</strong></span>
        </a>
        <nav class="nav-links">
          <a href="#problem">Masalah</a>
          <a href="#solution">Solusi</a>
          <a href="#features">Fakta</a>
          <a href="#audience">Untuk Siapa</a>
          <a href="#pricing" class="btn-nav">AMBIL PROMO</a>
        </nav>
      </div>
    </header>

    <!-- Main Content -->
    <main>
      <Hero8 />
      <Problem8 />
      <Solution8 />
      <Features8 />
      <Audience8 />
      <Pricing8 />
    </main>

    <!-- Footer -->
    <footer class="footer-dark">
      <div class="container text-center">
        <p class="footer-logo">
          <Sparkles class="footer-logo-icon" />
          <span>PROMPT AI CANVA CODE</span>
        </p>
        <p class="footer-tagline">Membantu Guru Kreatif Mengajar Lebih Cepat, Seru, dan Interaktif.</p>
        <div class="footer-divider"></div>
        <p class="copyright">© 2026 Prompt AI Canva Code. All Rights Reserved.</p>
      </div>
    </footer>
  </div>
</Layout>

<style is:global>
  .template-8-root {
    background: #090d16;
    color: #ffffff;
    font-family: "Inter", sans-serif;
    scroll-behavior: smooth;
  }

  .template-8-root section {
    scroll-margin-top: 80px;
  }
</style>

<style>
  /* Header Styles */
  .header-nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 80px;
    background: rgba(9, 13, 22, 0.8);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    z-index: 100;
    display: flex;
    align-items: center;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    padding: 0 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: #ffffff;
    font-size: 18px;
    font-weight: 700;
  }

  .logo-icon {
    width: 20px;
    height: 20px;
    color: #fbbf24;
  }

  .logo strong {
    color: #60a5fa;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links a {
    text-decoration: none;
    color: #94a3b8;
    font-size: 14px;
    font-weight: 600;
    transition: color 0.3s;
  }

  .nav-links a:hover {
    color: #ffffff;
  }

  .nav-links .btn-nav {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
    padding: 10px 20px;
    border-radius: 12px;
    font-weight: 800;
    box-shadow: 0 4px 15px rgba(16, 185, 129, 0.2);
  }

  .nav-links .btn-nav:hover {
    background: linear-gradient(135deg, #34d399 0%, #10b981 100%);
    transform: translateY(-1px);
  }

  /* Footer Styles */
  .footer-dark {
    background: #06090f;
    padding: 60px 0 40px;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
  }

  .text-center {
    text-align: center;
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 20px;
    font-weight: 850;
    color: #ffffff;
    margin-bottom: 12px;
  }

  .footer-logo-icon {
    width: 22px;
    height: 22px;
    color: #fbbf24;
  }

  .footer-tagline {
    font-size: 14px;
    color: #64748b;
    margin-bottom: 30px;
  }

  .footer-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.05);
    max-width: 600px;
    margin: 0 auto 30px;
  }

  .copyright {
    font-size: 12px;
    color: #475569;
  }

  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }
  }
</style>

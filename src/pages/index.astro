---
import Layout from "../layouts/Layout.astro";
import Header from "../components/home/Header.astro";
import Hero from "../components/home/Hero.astro";
import Services from "../components/home/Services.astro";
import Portfolio from "../components/home/Portfolio.astro";
import Stats from "../components/home/Stats.astro";
import Pricing from "../components/home/Pricing.astro";
import Contact from "../components/home/Contact.astro";
import Footer from "../components/home/Footer.astro";
---

<Layout 
  title="DigiWarung Tech Studio — Jasa Pembuatan Website, Aplikasi Developer & Agensi Promosi" 
  description="Hubungi DigiWarung Tech Studio untuk jasa pembuatan website portal berita nasional, aplikasi mobile pintar kustom, dan optimasi agensi promosi SaaS produk Anda."
>
  <div class="home-root">
    <Header />
    <main>
      <Hero />
      <Services />
      <Portfolio />
      <Stats />
      <Pricing />
      <Contact />
    </main>
    <Footer />
  </div>
</Layout>

<style is:global>
  /* Import Google Fonts */
  @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');

  :root {
    --font-home: 'Plus Jakarta Sans', 'Inter', sans-serif;
  }

  .home-root {
    background-color: #0a0915;
    color: #cbd5e1;
    font-family: var(--font-home);
    scroll-behavior: smooth;
  }

  .home-root h1, 
  .home-root h2, 
  .home-root h3, 
  .home-root h4, 
  .home-root h5, 
  .home-root h6 {
    font-family: var(--font-home);
    color: #ffffff;
    letter-spacing: -0.025em;
  }

  /* Reset layout constraints and styles */
  .home-root .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .home-root .text-center {
    text-align: center;
  }

  .home-root a {
    text-decoration: none;
    color: inherit;
  }

  .home-root ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  /* Custom generic buttons for home page */
  .home-root .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50px;
    font-weight: 700;
    font-size: 15px;
    padding: 12px 28px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    text-decoration: none;
  }

  /* Global Animations */
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: .5; }
  }

  .animate-pulse {
    animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  /* Hide default browser scrollbars for clean presentation */
  .home-root ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  .home-root ::-webkit-scrollbar-track {
    background: #06050b;
  }

  .home-root ::-webkit-scrollbar-thumb {
    background: #1e1b4b;
    border-radius: 4px;
  }

  .home-root ::-webkit-scrollbar-thumb:hover {
    background: #312e81;
  }
</style>

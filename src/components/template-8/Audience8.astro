---
import { XCircle, CheckCircle2 } from "@lucide/astro";
---

<section id="audience" class="audience-8">
  <div class="glow-decor-1"></div>
  <div class="glow-decor-2"></div>
  <div class="container">
    <div class="audience-grid">
      <!-- Left Column: NOT for you -->
      <div class="audience-col negative-box">
        <h3 class="col-title text-red">Ini BUKAN untuk kamu kalau...</h3>
        <ul class="audience-list">
          <li>
            <XCircle class="icon icon-red" />
            <span>Kamu sudah puas dengan cara mengajar yang sekarang</span>
          </li>
          <li>
            <XCircle class="icon icon-red" />
            <span>Kamu nggak peduli siswa bosan atau tidak saat kamu mengajar</span>
          </li>
          <li>
            <XCircle class="icon icon-red" />
            <span>Kamu suka buang waktu berjam-jam bikin materi secara manual</span>
          </li>
        </ul>
      </div>

      <!-- Right Column: MUST for you -->
      <div class="audience-col positive-box">
        <h3 class="col-title text-green">Ini WAJIB untuk kamu kalau...</h3>
        <ul class="audience-list">
          <li>
            <CheckCircle2 class="icon icon-green" />
            <span>Kamu guru SD, SMP, SMA yang mau naik level</span>
          </li>
          <li>
            <CheckCircle2 class="icon icon-green" />
            <span>Kamu dosen yang mau kelasnya lebih hidup dan interaktif</span>
          </li>
          <li>
            <CheckCircle2 class="icon icon-green" />
            <span>Kamu tutor atau pengajar les yang mau tampil beda dari yang lain</span>
          </li>
          <li>
            <CheckCircle2 class="icon icon-green" />
            <span>Kamu content creator edukasi yang mau konten lebih engaging</span>
          </li>
          <li>
            <CheckCircle2 class="icon icon-green" />
            <span>Kamu siapapun yang mau manfaatkan AI secara nyata — bukan sekadar tahu doang</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .audience-8 {
    padding: 100px 0;
    background-color: #0b0f19;
    color: #ffffff;
    position: relative;
    overflow: hidden;
  }

  .glow-decor-1 {
    position: absolute;
    top: 20%;
    left: -10%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(239, 68, 68, 0.02) 0%, transparent 70%);
    pointer-events: none;
  }

  .glow-decor-2 {
    position: absolute;
    bottom: 20%;
    right: -10%;
    width: 350px;
    height: 350px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.02) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .audience-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 40px;
    align-items: stretch;
  }

  .audience-col {
    padding: 48px 40px;
    border-radius: 28px;
    display: flex;
    flex-direction: column;
    height: 100%;
    box-sizing: border-box;
    backdrop-filter: blur(10px);
    transition: all 0.3s ease;
  }

  .negative-box {
    background: rgba(239, 68, 68, 0.02);
    border: 1px solid rgba(239, 68, 68, 0.12);
  }

  .negative-box:hover {
    border-color: rgba(239, 68, 68, 0.3);
    background: rgba(239, 68, 68, 0.04);
    box-shadow: 0 20px 40px rgba(239, 68, 68, 0.04);
    transform: translateY(-2px);
  }

  .positive-box {
    background: rgba(16, 185, 129, 0.02);
    border: 1px solid rgba(16, 185, 129, 0.12);
  }

  .positive-box:hover {
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(16, 185, 129, 0.04);
    box-shadow: 0 20px 40px rgba(16, 185, 129, 0.04);
    transform: translateY(-2px);
  }

  .col-title {
    font-size: 24px;
    font-weight: 850;
    margin-bottom: 32px;
    letter-spacing: -0.5px;
  }

  .text-red {
    color: #f87171;
  }

  .text-green {
    color: #34d399;
  }

  .audience-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .audience-list li {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
  }

  .negative-box .audience-list li {
    color: #cbd5e1;
  }

  .positive-box .audience-list li {
    color: #e2e8f0;
  }

  .icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .icon-red {
    color: #f87171;
  }

  .icon-green {
    color: #34d399;
  }

  @media (max-width: 992px) {
    .audience-grid {
      grid-template-columns: 1fr;
      gap: 30px;
    }
  }

  @media (max-width: 480px) {
    .audience-col {
      padding: 32px 20px;
    }
    .col-title {
      font-size: 20px;
    }
  }
</style>

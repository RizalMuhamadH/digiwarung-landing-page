---
import { Image } from "astro:assets";
import previewImg from "@/assets/template-8-preview.png";
import { Sparkles, ArrowRight } from "@lucide/astro";
---

<section id="home" class="hero-8">
  <div class="glow-effect"></div>
  <div class="container">
    <div class="hero-wrapper">
      <div class="hero-content">
        <span class="eyebrow">
          <Sparkles class="icon-sparkle" />
          🔥 GURU WAJIB PUNYA INI!
        </span>

        <h1 class="main-title">
          Ngapain Buang Waktu <br class="desktop-only" />
          <span class="highlight-text">Berjam-jam</span> Bikin Materi?
        </h1>

        <p class="sub-title">
          Guru lain sudah pakai AI. Siswa mereka lebih semangat, kelasnya lebih
          hidup. Kamu masih bikin slide biasa?
        </p>

        <div class="price-box">
          <span class="old-price">Rp 175.000</span>
          <span class="new-price">Rp 125.000</span>
        </div>

        <div class="cta-wrapper">
          <a href="#pricing" class="btn-cta">
            <span>AMBIL SEKARANG SEBELUM KEHABISAN</span>
            <ArrowRight class="btn-icon" />
          </a>
          <span class="urgency-tag">⚠️ Harga bisa naik kapan saja</span>
        </div>
      </div>

      <div class="hero-visual">
        <div class="image-card">
          <Image
            src={previewImg}
            alt="AI Prompts for Teachers Preview"
            class="mockup-img"
          />
          <div class="badge-floating">100+ Prompt Siap Pakai</div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-8 {
    padding: 120px 0 80px;
    background: radial-gradient(circle at 10% 20%, #1e1b4b 0%, #0f172a 90%);
    color: #f8fafc;
    position: relative;
    overflow: hidden;
  }

  .glow-effect {
    position: absolute;
    top: -10%;
    right: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.15) 0%,
      transparent 70%
    );
    z-index: 0;
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .hero-wrapper {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(245, 158, 11, 0.15);
    color: #f59e0b;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 1px;
    margin-bottom: 24px;
    border: 1px solid rgba(245, 158, 11, 0.3);
    animation: pulse 2s infinite;
  }

  .icon-sparkle {
    width: 16px;
    height: 16px;
  }

  @keyframes pulse {
    0% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.03);
    }
    100% {
      transform: scale(1);
    }
  }

  .main-title {
    font-size: 54px;
    font-weight: 900;
    line-height: 1.15;
    color: #ffffff;
    margin-bottom: 24px;
    letter-spacing: -1.5px;
  }

  .highlight-text {
    background: linear-gradient(to right, #fbbf24, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .sub-title {
    font-size: 18px;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 32px;
    max-width: 580px;
  }

  .price-box {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-bottom: 36px;
    background: rgba(255, 255, 255, 0.03);
    padding: 12px 24px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.08);
  }

  .old-price {
    font-size: 20px;
    text-decoration: line-through;
    color: #64748b;
    font-weight: 600;
  }

  .new-price {
    font-size: 32px;
    font-weight: 850;
    color: #10b981;
  }

  .cta-wrapper {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
  }

  .btn-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
    color: #0f172a;
    padding: 20px 36px;
    border-radius: 16px;
    font-size: 18px;
    font-weight: 800;
    text-decoration: none;
    box-shadow: 0 10px 30px rgba(245, 158, 11, 0.3);
    transition: all 0.3s ease;
    text-align: center;
  }

  .btn-cta:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(245, 158, 11, 0.45);
    background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%);
  }

  .btn-icon {
    width: 20px;
    height: 20px;
    transition: transform 0.3s ease;
  }

  .btn-cta:hover .btn-icon {
    transform: translateX(4px);
  }

  .urgency-tag {
    font-size: 14px;
    color: #cbd5e1;
    font-weight: 600;
    font-style: italic;
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .image-card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: #1e293b;
    transition: transform 0.5s ease;
  }

  .image-card:hover {
    transform: translateY(-5px) scale(1.01);
  }

  .mockup-img {
    width: 100%;
    max-width: 460px;
    height: auto;
    display: block;
  }

  .badge-floating {
    position: absolute;
    bottom: 20px;
    left: 20px;
    background: #6366f1;
    color: white;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 700;
    box-shadow: 0 10px 20px rgba(99, 102, 241, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .desktop-only {
    display: block;
  }

  @media (max-width: 992px) {
    .hero-wrapper {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .hero-content {
      align-items: center;
      text-align: center;
    }

    .sub-title {
      max-width: 100%;
    }

    .main-title {
      font-size: 40px;
    }

    .btn-cta {
      width: 100%;
      box-sizing: border-box;
    }

    .desktop-only {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .hero-8 {
      padding: 80px 0 60px;
    }

    .main-title {
      font-size: 32px;
    }

    .price-box {
      flex-direction: column;
      gap: 4px;
      width: 100%;
      align-items: center;
    }

    .new-price {
      font-size: 28px;
    }
  }
</style>

---
import { CheckCircle2, Check, Sparkles } from "@lucide/astro";
---

<section id="solution" class="solution-8">
  <div class="decor-blob-1"></div>
  <div class="decor-blob-2"></div>
  
  <div class="container">
    <div class="solution-box text-center">
      <span class="eyebrow">
        <Sparkles class="icon-sparkle" />
        Kenalan sama senjata rahasia guru-guru kreatif:
      </span>
      
      <h2 class="product-title">PROMPT AI CANVA CODE</h2>
      
      <p class="subtitle">Bukan kursus panjang. Bukan teori bertele-tele.</p>
      
      <p class="description">
        Ini <strong>100+ prompt AI siap pakai</strong> — tinggal copy, paste, dan dalam hitungan menit kamu sudah punya materi pembelajaran yang interaktif, menarik, dan bikin siswa nggak mau pulang.
      </p>

      <div class="features-checklist">
        <div class="check-item">
          <div class="check-icon">
            <Check class="icon" />
          </div>
          <span class="check-text">Kuis interaktif? <span class="badge-success">✅</span></span>
        </div>

        <div class="check-item">
          <div class="check-icon">
            <Check class="icon" />
          </div>
          <span class="check-text">Simulasi seru? <span class="badge-success">✅</span></span>
        </div>

        <div class="check-item">
          <div class="check-icon">
            <Check class="icon" />
          </div>
          <span class="check-text">Halaman web pembelajaran? <span class="badge-success">✅</span></span>
        </div>

        <div class="check-item">
          <div class="check-icon">
            <Check class="icon" />
          </div>
          <span class="check-text">Papan brainstorming visual? <span class="badge-success">✅</span></span>
        </div>

        <div class="check-item highlight-item">
          <div class="check-icon glow-check">
            <Check class="icon" />
          </div>
          <span class="check-text font-bold">11 jenis media belajar berbeda? <span class="badge-success">✅✅✅</span></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .solution-8 {
    padding: 120px 0;
    background: #090d16;
    color: #f8fafc;
    position: relative;
    overflow: hidden;
  }

  .decor-blob-1 {
    position: absolute;
    top: -10%;
    left: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 0%, transparent 70%);
    pointer-events: none;
  }

  .decor-blob-2 {
    position: absolute;
    bottom: -10%;
    right: -10%;
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .solution-box {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 32px;
    padding: 60px 40px;
    backdrop-filter: blur(10px);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(99, 102, 241, 0.15);
    color: #818cf8;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.5px;
    margin-bottom: 24px;
    border: 1px solid rgba(99, 102, 241, 0.2);
  }

  .icon-sparkle {
    width: 16px;
    height: 16px;
  }

  .product-title {
    font-size: 48px;
    font-weight: 950;
    line-height: 1.1;
    margin-bottom: 20px;
    letter-spacing: -1.5px;
    background: linear-gradient(135deg, #06b6d4 0%, #3b82f6 50%, #8b5cf6 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .subtitle {
    font-size: 20px;
    color: #e2e8f0;
    font-weight: 600;
    margin-bottom: 24px;
  }

  .description {
    font-size: 18px;
    line-height: 1.7;
    color: #94a3b8;
    max-width: 700px;
    margin: 0 auto 48px;
  }

  .description strong {
    color: #ffffff;
  }

  .features-checklist {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 500px;
    margin: 0 auto;
    text-align: left;
  }

  .check-item {
    display: flex;
    align-items: center;
    gap: 16px;
    background: rgba(255, 255, 255, 0.03);
    padding: 16px 20px;
    border-radius: 16px;
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.3s ease;
  }

  .check-item:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.12);
    transform: translateX(4px);
  }

  .check-icon {
    width: 28px;
    height: 28px;
    background: #10b981;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .check-icon .icon {
    width: 16px;
    height: 16px;
    color: #090d16;
    stroke-width: 3;
  }

  .check-text {
    font-size: 16px;
    font-weight: 600;
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
  }

  .highlight-item {
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
  }

  .highlight-item:hover {
    background: rgba(16, 185, 129, 0.12);
    border-color: rgba(16, 185, 129, 0.4);
  }

  .glow-check {
    background: #10b981;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.6);
  }

  .font-bold {
    font-weight: 800;
    color: #ffffff;
  }

  .badge-success {
    margin-left: 8px;
  }

  @media (max-width: 768px) {
    .solution-box {
      padding: 40px 24px;
    }
    
    .product-title {
      font-size: 34px;
    }

    .subtitle {
      font-size: 18px;
    }

    .description {
      font-size: 16px;
    }
  }
</style>

---
import { Mail, Target, ArrowRight, ShieldCheck, MailOpen, Rocket, ShoppingCart } from "@lucide/astro";
---

<section id="pricing" class="pricing-7">
  <div class="container-narrow">
    <!-- Pricing Card -->
    <div class="pricing-card">
      <div class="card-header text-center">
        <span class="promo-badge">💰 HARGA PROMO TERBATAS</span>
        <h2>Amankan Slot Kamu Sekarang!</h2>
        <p class="sub-text">Kesempatan terbaik untuk mulai cuan dari affiliate</p>
      </div>
      
      <div class="price-display text-center">
        <div class="old-price">Rp75.000</div>
        <div class="new-price">
          <span class="currency">Hanya</span> Rp35.000
        </div>
      </div>

      <div class="urgency-note text-center">
        <p>⚠️ Harga bisa naik kapan saja.</p>
        <p class="highlight">Amankan sekarang sebelum promo berakhir!</p>
      </div>

      <!-- Shipping Info -->
      <div class="shipping-info">
        <div class="info-box">
          <div class="icon-circle">
            <MailOpen class="h-6 w-6 text-blue" />
          </div>
          <div class="info-text">
            <h4>📦 Cara Pengiriman</h4>
            <p>Produk digital akan dikirim melalui <strong>email</strong> yang kamu cantumkan saat pembelian.</p>
          </div>
        </div>
      </div>

      <!-- CTA Area -->
      <div class="cta-area">
        <a href="#" class="btn-primary">
          <ShoppingCart class="h-6 w-6" />
          <span>BELI SEKARANG & MULAI JUALAN</span>
        </a>
        <div class="payment-trust">
          <ShieldCheck class="h-4 w-4" />
          <span>Pembayaran Aman & Terverifikasi</span>
        </div>
      </div>
    </div>

    <!-- Final CTA Section -->
    <div class="final-cta-section text-center">
      <div class="icon-glow">
        <Target class="h-12 w-12 text-red" />
      </div>
      <h3>🎯 Mulai Affiliate Lebih Mudah Hari Ini</h3>
      <p>Ribuan video sudah siap membantu kamu mulai upload, promosi, dan menghasilkan. Tidak perlu ribet bikin konten dari nol.</p>
      
      <div class="final-pointer">
        <ArrowRight class="h-5 w-5 bounce-x" />
        <span>Klik tombol beli sekarang dan mulai jualan hari ini!</span>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-7 {
    padding: 120px 0;
    background: #000;
    color: white;
    position: relative;
    overflow: hidden;
  }

  /* Decorative glow */
  .pricing-7::after {
    content: '';
    position: absolute;
    bottom: -150px;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(circle, rgba(211, 47, 47, 0.15) 0%, transparent 70%);
    z-index: 0;
  }

  .container-narrow {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  /* Pricing Card */
  .pricing-card {
    background: white;
    color: #000;
    border-radius: 40px;
    padding: 60px 40px;
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
    border: 4px solid #d32f2f;
    margin-bottom: 80px;
    transition: transform 0.3s ease;
  }

  .pricing-card:hover {
    transform: translateY(-5px);
  }

  .promo-badge {
    display: inline-block;
    background: #fef2f2;
    color: #d32f2f;
    padding: 8px 16px;
    border-radius: 100px;
    font-size: 13px;
    font-weight: 900;
    margin-bottom: 24px;
    letter-spacing: 0.5px;
  }

  .card-header h2 {
    font-size: 32px;
    font-weight: 950;
    margin-bottom: 12px;
    letter-spacing: -1px;
  }

  .sub-text {
    font-size: 16px;
    color: #64748b;
    margin-bottom: 40px;
  }

  .price-display {
    margin-bottom: 32px;
  }

  .old-price {
    font-size: 24px;
    color: #94a3b8;
    text-decoration: line-through;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .new-price {
    font-size: 72px;
    font-weight: 950;
    color: #d32f2f;
    line-height: 1;
  }

  .new-price .currency {
    font-size: 20px;
    vertical-align: middle;
    margin-right: 8px;
    color: #000;
  }

  .urgency-note {
    background: #fff8f8;
    padding: 20px;
    border-radius: 20px;
    margin-bottom: 40px;
  }

  .urgency-note p {
    font-size: 15px;
    font-weight: 700;
    margin-bottom: 4px;
  }

  .urgency-note .highlight {
    color: #d32f2f;
    font-size: 16px;
  }

  /* Shipping Info */
  .shipping-info {
    margin-bottom: 40px;
  }

  .info-box {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    background: #f8fafc;
    padding: 24px;
    border-radius: 24px;
    border: 1px solid #e2e8f0;
  }

  .icon-circle {
    width: 48px;
    height: 48px;
    background: white;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    flex-shrink: 0;
  }

  .info-text h4 {
    font-size: 18px;
    font-weight: 900;
    margin-bottom: 6px;
  }

  .info-text p {
    font-size: 14px;
    color: #475569;
    line-height: 1.6;
  }

  /* CTA Area */
  .btn-primary {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #d32f2f;
    color: white;
    padding: 24px;
    border-radius: 20px;
    font-size: 20px;
    font-weight: 900;
    text-decoration: none;
    box-shadow: 0 20px 40px rgba(211, 47, 47, 0.3);
    margin-bottom: 20px;
    transition: all 0.3s ease;
  }

  .btn-primary:hover {
    transform: scale(1.02);
    background: #b71c1c;
    box-shadow: 0 25px 50px rgba(211, 47, 47, 0.4);
  }

  .payment-trust {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 13px;
    color: #94a3b8;
    font-weight: 600;
  }

  /* Final CTA Section */
  .final-cta-section {
    padding-top: 40px;
  }

  .icon-glow {
    width: 80px;
    height: 80px;
    background: rgba(211, 47, 47, 0.1);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 32px;
    box-shadow: 0 0 40px rgba(211, 47, 47, 0.2);
  }

  .final-cta-section h3 {
    font-size: 32px;
    font-weight: 950;
    margin-bottom: 20px;
    color: #fff;
    letter-spacing: -1px;
  }

  .final-cta-section p {
    font-size: 18px;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 32px;
  }

  .final-pointer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #ef4444;
    font-weight: 800;
    font-size: 16px;
  }

  .bounce-x {
    animation: bounceX 1s infinite alternate;
  }

  @keyframes bounceX {
    from { transform: translateX(0); }
    to { transform: translateX(8px); }
  }

  @media (max-width: 640px) {
    .pricing-card {
      padding: 40px 24px;
    }
    .new-price {
      font-size: 52px;
    }
    .final-cta-section h3 {
      font-size: 26px;
    }
  }
</style>

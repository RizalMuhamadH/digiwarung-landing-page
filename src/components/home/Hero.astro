---
---
<section class="hero-section" id="home">
  <!-- Glowing Background Blobs -->
  <div class="blob blob-purple"></div>
  <div class="blob blob-cyan"></div>
  <div class="blob blob-emerald"></div>

  <div class="container hero-container">
    <div class="hero-text-content">
      <div class="badge-new animate-pulse">
        <span class="badge-dot"></span>
        <span>DigiWarung Tech Studio — Developer & Agensi Digital</span>
      </div>

      <h1 class="hero-headline">
        Ubah Ide Digital Menjadi Platform <br />
        <span class="gradient-text font-black">Berskala Nasional</span>
      </h1>

      <p class="hero-description">
        Kami merancang & membangun Website Media Berita Nasional, Aplikasi Mobile Kustom Berfitur Pintar, dan Sistem SaaS Enterprise untuk mempercepat pertumbuhan produk & promosi bisnis Anda secara tak terbatas.
      </p>

      <div class="hero-actions">
        <a href="#portfolio" class="btn btn-primary-gradient">
          <span>Lihat Portofolio Kami</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="arrow-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
        <a href="#contact" class="btn btn-secondary-outline">
          <span>Mulai Konsultasi</span>
        </a>
      </div>

      <div class="hero-trust">
        <p class="trust-title">DIPERCAYA OLEH KLIEN MEDIA & ENTERPRISE:</p>
        <div class="trust-logos">
          <span class="trust-logo">AyoBandung.id</span>
          <span class="trust-logo">AyoJakarta.com</span>
          <span class="trust-logo">AyoBiz.id</span>
          <span class="trust-logo">AyoJelajah.id</span>
          <span class="trust-logo">AyoTekno.id</span>
        </div>
      </div>
    </div>

    <div class="hero-visual-content">
      <div class="mockup-container">
        <!-- Floating Element 1: Smart City Splash -->
        <div class="floating-widget widget-app">
          <div class="widget-header">
            <span class="widget-circle circle-red"></span>
            <span class="widget-circle circle-yellow"></span>
            <span class="widget-circle circle-green"></span>
            <span class="widget-title">AyoApp v2.1</span>
          </div>
          <div class="widget-body">
            <div class="app-avatar-row">
              <span class="app-icon-pic">📱</span>
              <div>
                <p class="app-name">Wow Bekasi</p>
                <p class="app-status">Smart City App • Active</p>
              </div>
            </div>
            <div class="app-progressbar">
              <div class="bar-fill" style="width: 87%"></div>
            </div>
            <div class="app-stats">
              <span>99.9% Uptime</span>
              <span>100K+ Unduhan</span>
            </div>
          </div>
        </div>

        <!-- Floating Element 2: SaaS Console -->
        <div class="floating-widget widget-dashboard">
          <div class="widget-header">
            <span class="widget-circle circle-red"></span>
            <span class="widget-circle circle-yellow"></span>
            <span class="widget-circle circle-green"></span>
            <span class="widget-title">GravSpace Console</span>
          </div>
          <div class="widget-body">
            <div class="dash-row">
              <div class="dash-stat">
                <span class="stat-label">Logic Capacity</span>
                <span class="stat-value">27.34 MB</span>
              </div>
              <div class="dash-chart">
                <svg viewBox="0 0 100 40" class="mini-chart">
                  <path d="M0,35 Q15,10 30,28 T60,5 T90,32 L100,40 L0,40 Z" fill="rgba(99, 102, 241, 0.2)" stroke="#6366f1" stroke-width="2"></path>
                </svg>
              </div>
            </div>
            <div class="dash-list">
              <div class="dash-list-item">
                <span class="status-dot green"></span>
                <span>cors-test-bucket</span>
                <span class="tag">PUBLIC</span>
              </div>
              <div class="dash-list-item">
                <span class="status-dot purple"></span>
                <span>prod-verified-final</span>
                <span class="tag">SECURE</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Central Mockup: Code Terminal & Portal Preview -->
        <div class="main-terminal">
          <div class="terminal-header">
            <div class="terminal-dots">
              <span></span>
              <span></span>
              <span></span>
            </div>
            <span class="terminal-title">digiwarung-deploy.sh</span>
          </div>
          <div class="terminal-body font-mono">
            <p class="text-emerald">$ npm run deploy --prod</p>
            <p class="text-muted">Analyzing source bundle (Astro v6.1)...</p>
            <p class="text-cyan">✔ 5 news portal sites compiled successfully.</p>
            <p class="text-cyan">✔ WOW Bekasi Mobile build ready (iOS & Android).</p>
            <p class="text-cyan">✔ GravSpace S3 cluster storage connected.</p>
            <p class="text-purple">Deploying production cluster with 99.9% CDN coverage...</p>
            <p class="text-emerald">▶ Platform ONLINE: https://www.ayobandung.id</p>
            <p class="text-emerald">▶ Platform ONLINE: https://www.ayojakarta.com</p>
            <p class="text-yellow">▶ Systems operational. Monitoring live logs...</p>
            <div class="terminal-cursor"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 160px 0 100px;
    background-color: #0a0915;
    overflow: hidden;
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  /* Neon Glow Blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    opacity: 0.15;
    z-index: 1;
    pointer-events: none;
  }

  .blob-purple {
    top: 15%;
    left: 10%;
    width: 350px;
    height: 350px;
    background-color: #6366f1;
  }

  .blob-cyan {
    bottom: 20%;
    right: 15%;
    width: 400px;
    height: 400px;
    background-color: #06b6d4;
  }

  .blob-emerald {
    top: 50%;
    left: 45%;
    width: 300px;
    height: 300px;
    background-color: #10b981;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
    position: relative;
    z-index: 10;
  }

  .hero-text-content {
    max-width: 680px;
  }

  .badge-new {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 100px;
    color: #a5b4fc;
    font-size: 13px;
    font-weight: 500;
    margin-bottom: 28px;
    backdrop-filter: blur(10px);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .hero-headline {
    color: #ffffff;
    font-size: 52px;
    font-weight: 900;
    line-height: 1.15;
    letter-spacing: -1.5px;
    margin-bottom: 24px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #a5b4fc, #6366f1, #06b6d4, #10b981);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 10px rgba(99, 102, 241, 0.2));
  }

  .hero-description {
    color: #94a3b8;
    font-size: 18px;
    line-height: 1.6;
    margin-bottom: 40px;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    margin-bottom: 50px;
    flex-wrap: wrap;
  }

  .btn-primary-gradient {
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #ffffff;
    padding: 16px 32px;
    font-size: 16px;
    font-weight: 600;
    box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    border-radius: 50px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: none;
    transition: all 0.3s ease;
  }

  .btn-primary-gradient:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 35px rgba(99, 102, 241, 0.5);
    background: linear-gradient(135deg, #4f46e5, #0891b2);
  }

  .btn-primary-gradient:hover .arrow-icon {
    transform: translateX(4px);
  }

  .arrow-icon {
    transition: transform 0.3s ease;
  }

  .btn-secondary-outline {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 16px 32px;
    font-size: 16px;
    font-weight: 600;
    border-radius: 50px;
    transition: all 0.3s ease;
  }

  .btn-secondary-outline:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
    transform: translateY(-3px);
  }

  .hero-trust {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 24px;
  }

  .trust-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: #64748b;
    margin-bottom: 12px;
  }

  .trust-logos {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    align-items: center;
  }

  .trust-logo {
    color: #475569;
    font-weight: 600;
    font-size: 14px;
    transition: color 0.3s ease;
  }

  .trust-logo:hover {
    color: #94a3b8;
  }

  /* Visual Column (Mockups) */
  .hero-visual-content {
    display: flex;
    justify-content: center;
    position: relative;
  }

  .mockup-container {
    position: relative;
    width: 100%;
    max-width: 480px;
    height: 400px;
  }

  /* Terminal Code Design */
  .main-terminal {
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.4);
    width: 100%;
    position: absolute;
    top: 50px;
    left: 0;
    z-index: 10;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding-bottom: 10px;
  }

  .terminal-dots {
    display: flex;
    gap: 6px;
  }

  .terminal-dots span {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.2);
  }

  .terminal-dots span:nth-child(1) { background-color: #ef4444; }
  .terminal-dots span:nth-child(2) { background-color: #f59e0b; }
  .terminal-dots span:nth-child(3) { background-color: #10b981; }

  .terminal-title {
    font-size: 11px;
    color: #64748b;
    font-family: monospace;
  }

  .terminal-body {
    font-size: 12px;
    line-height: 1.7;
    height: 200px;
    overflow-y: hidden;
  }

  .font-mono {
    font-family: 'Courier New', Courier, monospace;
  }

  .text-emerald { color: #10b981; }
  .text-cyan { color: #06b6d4; }
  .text-purple { color: #818cf8; }
  .text-yellow { color: #fbbf24; }
  .text-muted { color: #475569; }

  .terminal-cursor {
    display: inline-block;
    width: 6px;
    height: 12px;
    background: #10b981;
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  /* Floating Widget: App Simulator */
  .floating-widget {
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 12px 16px;
    position: absolute;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.3);
    z-index: 20;
    transition: transform 0.3s ease;
  }

  .widget-app {
    top: -30px;
    right: -20px;
    width: 200px;
    animation: floatWidget 5s ease-in-out infinite;
  }

  .widget-dashboard {
    bottom: -40px;
    left: -20px;
    width: 230px;
    animation: floatWidget 7s ease-in-out infinite;
    animation-delay: 1s;
  }

  .widget-header {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 8px;
  }

  .widget-circle {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }
  .circle-red { background: #ef4444; }
  .circle-yellow { background: #f59e0b; }
  .circle-green { background: #10b981; }

  .widget-title {
    font-size: 9px;
    color: #64748b;
    margin-left: 4px;
    font-weight: 600;
  }

  .app-avatar-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
  }

  .app-icon-pic {
    font-size: 20px;
  }

  .app-name {
    font-size: 12px;
    font-weight: 700;
    color: #ffffff;
    margin: 0;
  }

  .app-status {
    font-size: 9px;
    color: #64748b;
    margin: 0;
  }

  .app-progressbar {
    height: 4px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 6px;
  }

  .bar-fill {
    height: 100%;
    background: #06b6d4;
  }

  .app-stats {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: #10b981;
    font-weight: 600;
  }

  /* SaaS Widget style */
  .dash-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .dash-stat {
    display: flex;
    flex-direction: column;
  }

  .stat-label {
    font-size: 9px;
    color: #64748b;
  }

  .stat-value {
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
  }

  .dash-chart {
    width: 60px;
    height: 24px;
  }

  .mini-chart {
    width: 100%;
    height: 100%;
  }

  .dash-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .dash-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 9px;
    color: #94a3b8;
    background: rgba(255, 255, 255, 0.02);
    padding: 4px 6px;
    border-radius: 4px;
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  .status-dot.green { background: #10b981; }
  .status-dot.purple { background: #6366f1; }

  .dash-list-item .tag {
    font-size: 7px;
    padding: 1px 3px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.08);
    font-weight: bold;
  }

  /* Floating Animation */
  @keyframes floatWidget {
    0%, 100% { transform: translateY(0px) rotate(0deg); }
    50% { transform: translateY(-10px) rotate(1deg); }
  }

  /* Responsiveness */
  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      padding-top: 20px;
    }

    .hero-text-content {
      max-width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-headline {
      font-size: 38px;
    }

    .hero-description {
      font-size: 16px;
      margin: 0 auto 30px;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-visual-content {
      margin-top: 60px;
      height: 380px;
    }

    .mockup-container {
      max-width: 380px;
      height: 300px;
    }

    .main-terminal {
      top: 0;
    }

    .widget-app {
      top: -20px;
      right: 0;
    }

    .widget-dashboard {
      bottom: -10px;
      left: 0;
    }
  }

  @media (max-width: 480px) {
    .hero-headline {
      font-size: 32px;
    }
    
    .trust-logos {
      justify-content: center;
    }
    
    .widget-app, .widget-dashboard {
      display: none; /* Hide floating widgets on small screen for layout sanity */
    }
  }
</style>

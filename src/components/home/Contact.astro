<section class="contact-section" id="contact">
  <div class="container contact-container">
    <!-- Left Column: Contact info -->
    <div class="contact-info-panel">
      <div class="showcase-badge">Hubungi Kami</div>
      <h2>Mulai Transformasi <br />Digital Bisnis Anda</h2>
      <p class="lead-text">
        Diskusikan kebutuhan pembuatan website, aplikasi kustom, atau rencana
        promosi produk Anda dengan tim analis kami secara gratis.
      </p>

      <div class="contact-list">
        <div class="contact-item-row">
          <div class="icon-circle">📞</div>
          <div>
            <span>WhatsApp / Telepon</span>
            <strong>+62 812-3456-7890</strong>
          </div>
        </div>

        <div class="contact-item-row">
          <div class="icon-circle">✉️</div>
          <div>
            <span>Email Official</span>
            <strong>hello@ayolaunch.id</strong>
          </div>
        </div>

        <div class="contact-item-row">
          <div class="icon-circle">📍</div>
          <div>
            <span>Kantor Studio</span>
            <strong
              >Sudirman Central Business District (SCBD), Jakarta Selatan</strong
            >
          </div>
        </div>
      </div>

      <div class="support-tag-box">
        <span class="support-dot animate-pulse"></span>
        <p>Konsultasi & Estimasi Biaya 100% Gratis Tanpa Komitmen</p>
      </div>
    </div>

    <!-- Right Column: Inquiry Form -->
    <div class="contact-form-panel">
      <form class="inquiry-form" id="inquiryForm">
        <h3 class="form-title">Kirim Rencana Project</h3>
        <p class="form-subtitle">
          Formulir akan langsung diteruskan ke Tim Technical Architect kami.
        </p>

        <div class="form-grid">
          <div class="input-wrapper">
            <label for="client_name">Nama Lengkap</label>
            <input
              type="text"
              id="client_name"
              name="name"
              placeholder="Jhon Doe"
              required
            />
          </div>

          <div class="input-wrapper">
            <label for="client_whatsapp">Nomor WhatsApp</label>
            <input
              type="tel"
              id="client_whatsapp"
              name="whatsapp"
              placeholder="0812xxxxxxxx"
              required
            />
          </div>
        </div>

        <div class="input-wrapper">
          <label for="client_email">Alamat Email</label>
          <input
            type="email"
            id="client_email"
            name="email"
            placeholder="rizal@company.com"
            required
          />
        </div>

        <div class="input-wrapper">
          <label for="client_service">Layanan Yang Dibutuhkan</label>
          <select id="client_service" name="service" required>
            <option value="" disabled selected>Pilih Layanan Utama</option>
            <option value="website"
              >Enterprise Website Development (News / Media / Portal)</option
            >
            <option value="app"
              >Custom Mobile App Development (Android / iOS / Smart City)</option
            >
            <option value="saas"
              >SaaS Platform Development & Growth Agency</option
            >
          </select>
        </div>

        <div class="input-wrapper">
          <label for="client_message">Detail Kebutuhan / Pesan Anda</label>
          <textarea
            id="client_message"
            name="message"
            rows="4"
            placeholder="Jelaskan kebutuhan fungsionalitas, target traffic, atau ide promosi produk yang Anda miliki..."
            required></textarea>
        </div>

        <button type="submit" class="btn btn-submit-form" id="btnSubmitForm">
          <span>Kirim Rencana Project</span>
          <svg class="send-icon" viewBox="0 0 24 24"
            ><line x1="22" y1="2" x2="11" y2="13"></line><polygon
              points="22 2 15 22 11 13 2 9 22 2"></polygon></svg
          >
        </button>

        <div class="success-message" id="successMsg">
          🎉 Terima kasih! Rencana project Anda berhasil terkirim. Tim Technical
          Architect kami akan menghubungi Anda melalui WhatsApp dalam 1x24 jam.
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact-section {
    background-color: #06050b;
    padding: 120px 0;
    position: relative;
  }

  .contact-container {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  .contact-info-panel h2 {
    color: #ffffff;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 24px;
    letter-spacing: -1px;
  }

  .lead-text {
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 28px;
    margin-bottom: 40px;
  }

  .contact-item-row {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .icon-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }

  .contact-item-row span {
    display: block;
    font-size: 11px;
    color: #64748b;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 4px;
  }

  .contact-item-row strong {
    font-size: 16px;
    color: #ffffff;
    font-weight: 700;
  }

  .support-tag-box {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgba(16, 185, 129, 0.06);
    border: 1px solid rgba(16, 185, 129, 0.15);
    padding: 12px 18px;
    border-radius: 12px;
  }

  .support-tag-box .support-dot {
    width: 8px;
    height: 8px;
    background-color: #10b981;
    border-radius: 50%;
    box-shadow: 0 0 10px #10b981;
  }

  .support-tag-box p {
    color: #a7f3d0;
    font-size: 13px;
    font-weight: 600;
    margin: 0;
  }

  /* Form Styling */
  .contact-form-panel {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    padding: 48px;
    border-radius: 28px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(12px);
  }

  .form-title {
    color: #ffffff;
    font-size: 24px;
    font-weight: 700;
    margin-bottom: 8px;
  }

  .form-subtitle {
    color: #64748b;
    font-size: 13px;
    margin-bottom: 32px;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .input-wrapper {
    margin-bottom: 20px;
    display: flex;
    flex-direction: column;
  }

  .input-wrapper label {
    font-size: 12px;
    font-weight: 600;
    color: #cbd5e1;
    margin-bottom: 8px;
  }

  .input-wrapper input,
  .input-wrapper select,
  .input-wrapper textarea {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 12px 16px;
    color: #ffffff;
    font-size: 14px;
    outline: none;
    transition: all 0.3s ease;
  }

  .input-wrapper select option {
    background: #0f172a;
    color: #ffffff;
  }

  .input-wrapper input:focus,
  .input-wrapper select:focus,
  .input-wrapper textarea:focus {
    border-color: #6366f1;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: 0 0 10px rgba(99, 102, 241, 0.2);
  }

  .btn-submit-form {
    width: 100%;
    background: linear-gradient(135deg, #6366f1, #06b6d4);
    color: #ffffff;
    border: none;
    border-radius: 50px;
    padding: 16px;
    font-size: 15px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    box-shadow: 0 10px 25px rgba(99, 102, 241, 0.3);
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .btn-submit-form:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(99, 102, 241, 0.4);
    background: linear-gradient(135deg, #4f46e5, #0891b2);
  }

  .send-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Success Prompt state */
  .success-message {
    display: none;
    margin-top: 20px;
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 8px;
    padding: 16px;
    color: #a7f3d0;
    font-size: 13px;
    line-height: 1.6;
    animation: slideIn 0.3s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 992px) {
    .contact-container {
      grid-template-columns: 1fr;
      gap: 50px;
    }
  }

  @media (max-width: 580px) {
    .form-grid {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .contact-form-panel {
      padding: 30px 20px;
    }
  }
</style>

<script>
  // Simple form submission script simulating request sending
  const form = document.getElementById("inquiryForm") as HTMLFormElement | null;
  const successMsg = document.getElementById(
    "successMsg",
  ) as HTMLDivElement | null;
  const btnSubmit = document.getElementById(
    "btnSubmitForm",
  ) as HTMLButtonElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    if (btnSubmit) {
      btnSubmit.disabled = true;
      btnSubmit.innerText = "Mengirimkan...";
    }

    setTimeout(() => {
      form.reset();
      if (successMsg) successMsg.style.display = "block";
      if (btnSubmit) {
        btnSubmit.disabled = false;
        btnSubmit.style.display = "none";
      }
    }, 1200);
  });
</script>

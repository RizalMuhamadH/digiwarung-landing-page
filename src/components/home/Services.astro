<section class="services-section" id="services">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">
        Solusi Teknologi & Growth Terintegrasi <br />
        <span class="gradient-text">Untuk Skala Bisnis Anda</span>
      </h2>
      <p class="section-subtitle">
        Kami menyediakan 3 pilar layanan utama untuk membantu brand, perusahaan, dan agensi Anda mendominasi ekosistem digital nasional.
      </p>
    </div>

    <div class="services-grid">
      <!-- Service 1: Website Development -->
      <div class="service-card card-emerald">
        <div class="service-icon-bg">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        </div>
        <h3 class="service-title">Enterprise Web Development</h3>
        <p class="service-text">
          Pembuatan portal media berita, e-commerce, direktori bisnis kustom, dan web korporat berkecepatan tinggi dengan integrasi SEO tingkat lanjut. Mampu menampung jutaan traffic per hari.
        </p>
        <ul class="service-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Portal Berita & CMS Nasional
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Kecepatan & Optimasi SEO Ekstrem
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Serverless & Skalabilitas Awan
          </li>
        </ul>
        <a href="#portfolio" class="service-link">
          <span>Lihat Portofolio Web</span>
          <svg class="arrow-right" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Service 2: Mobile App Dev -->
      <div class="service-card card-cyan">
        <div class="service-icon-bg">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
        </div>
        <h3 class="service-title">Aplikasi & App Developer</h3>
        <p class="service-text">
          Rancang bangun aplikasi mobile (iOS & Android) kustom dengan arsitektur UI/UX interaktif, fungsionalitas cerdas (IoT/GIS/Smart City), serta sistem API backend yang super aman dan stabil.
        </p>
        <ul class="service-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Aplikasi Smart City & Booklet Digital
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Platform Android & iOS (Flutter/React Native)
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Integrasi API & Database Real-time
          </li>
        </ul>
        <a href="#portfolio" class="service-link">
          <span>Lihat Portofolio Aplikasi</span>
          <svg class="arrow-right" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>

      <!-- Service 3: SaaS & Promotion Agency -->
      <div class="service-card card-purple">
        <div class="service-icon-bg">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#6366f1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather"><path d="M21.21 15.89A10 10 0 1 1 8 2.83"></path><path d="M22 12A10 10 0 0 0 12 2v10z"></path></svg>
        </div>
        <h3 class="service-title">Agensi Promosi & Solusi SaaS</h3>
        <p class="service-text">
          Kembangkan bisnis Anda secara tersistem menggunakan platform SaaS kustom, dashboard analitik data cloud, otomatisasi promosi produk, manajemen asset cloud (seperti panel S3), dan strategi growth marketing.
        </p>
        <ul class="service-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Pembuatan Dashboard & SaaS Khusus
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Otomatisasi Funnel & Promosi Produk
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Analitik & Dashboard Manajemen Awan
          </li>
        </ul>
        <a href="#portfolio" class="service-link">
          <span>Lihat Portofolio SaaS</span>
          <svg class="arrow-right" viewBox="0 0 24 24"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .services-section {
    background-color: #0b0a1a;
    padding: 120px 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .section-header {
    max-width: 700px;
    margin: 0 auto 60px;
  }

  .section-title {
    color: #ffffff;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1, #06b6d4, #10b981);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.6;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 40px 32px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .service-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(800px circle at var(--x, 0px) var(--y, 0px), rgba(255, 255, 255, 0.06), transparent 40%);
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 1;
    pointer-events: none;
  }

  .service-card:hover::before {
    opacity: 1;
  }

  .service-card:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.04);
  }

  /* Specific border glow colors on card hovers */
  .card-emerald:hover {
    border-color: rgba(16, 185, 129, 0.3);
    box-shadow: 0 20px 40px rgba(16, 185, 129, 0.08);
  }

  .card-cyan:hover {
    border-color: rgba(6, 182, 212, 0.3);
    box-shadow: 0 20px 40px rgba(6, 182, 212, 0.08);
  }

  .card-purple:hover {
    border-color: rgba(99, 102, 241, 0.3);
    box-shadow: 0 20px 40px rgba(99, 102, 241, 0.08);
  }

  .service-icon-bg {
    width: 64px;
    height: 64px;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 28px;
    position: relative;
    z-index: 2;
  }

  .card-emerald .service-icon-bg {
    background: rgba(16, 185, 129, 0.1);
  }
  .card-cyan .service-icon-bg {
    background: rgba(6, 182, 212, 0.1);
  }
  .card-purple .service-icon-bg {
    background: rgba(99, 102, 241, 0.1);
  }

  .service-title {
    color: #ffffff;
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 16px;
    position: relative;
    z-index: 2;
  }

  .service-text {
    color: #94a3b8;
    font-size: 15px;
    line-height: 1.6;
    margin-bottom: 28px;
    flex-grow: 1;
    position: relative;
    z-index: 2;
  }

  .service-features {
    margin-bottom: 36px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    position: relative;
    z-index: 2;
  }

  .service-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #cbd5e1;
    font-size: 14px;
    font-weight: 500;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .card-emerald .check-icon { stroke: #10b981; }
  .card-cyan .check-icon { stroke: #06b6d4; }
  .card-purple .check-icon { stroke: #6366f1; }

  .service-link {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    transition: all 0.3s ease;
    margin-top: auto;
    position: relative;
    z-index: 2;
  }

  .card-emerald .service-link { color: #10b981; }
  .card-cyan .service-link { color: #06b6d4; }
  .card-purple .service-link { color: #6366f1; }

  .arrow-right {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.3s ease;
  }

  .service-link:hover .arrow-right {
    transform: translateX(4px);
  }

  @media (max-width: 992px) {
    .services-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr;
    }
    .section-title {
      font-size: 30px;
    }
  }
</style>

<script>
  // Add simple spotlight card mouse interaction effect
  const cards = document.querySelectorAll('.service-card') as NodeListOf<HTMLDivElement>;
  cards.forEach(card => {
    card.addEventListener('mousemove', e => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      card.style.setProperty('--x', `${x}px`);
      card.style.setProperty('--y', `${y}px`);
    });
  });
</script>

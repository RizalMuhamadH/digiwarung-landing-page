---

<section class="pricing-section" id="pricing">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">
        Paket Investasi Teknologi <br />
        <span class="gradient-text">Yang Fleksibel & Transparan</span>
      </h2>
      <p class="section-subtitle">
        Pilih paket layanan yang paling sesuai dengan target pertumbuhan bisnis
        digital Anda. Tidak ada biaya tersembunyi.
      </p>
    </div>

    <div class="pricing-grid">
      <!-- Plan 1: Web Portal -->
      <div class="pricing-card">
        <div class="card-badge">Portal Media & Web</div>
        <h3 class="plan-name">Enterprise News & Directory</h3>
        <p class="plan-desc">
          Optimasi penuh untuk platform media berita nasional & direktori bisnis
          regional.
        </p>

        <div class="plan-price">
          <span
            class="price-val"
            style="font-size: 28px; letter-spacing: normal; line-height: 1.2;"
            >Hubungi Sales</span
          >
        </div>

        <ul class="plan-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Custom CMS
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Hingga 5 Domain Jaringan Berita
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Optimasi Google News & SEO Setup
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Integrasi AdSense & Analytics
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Maintenance Server (Opsional)
          </li>
        </ul>

        <a href="#contact" class="btn btn-pricing-action">Mulai Project Web</a>
      </div>

      <!-- Plan 2: App Developer (RECOMMENDED) -->
      <div class="pricing-card highlighted">
        <div class="recommended-ribbon">POPULER</div>
        <div class="card-badge cyan">Aplikasi Developer</div>
        <h3 class="plan-name">Custom Mobile App Development</h3>
        <p class="plan-desc">
          Solusi aplikasi kustom Android & iOS lengkap dengan backend
          terintegrasi.
        </p>

        <div class="plan-price">
          <span
            class="price-val"
            style="font-size: 28px; letter-spacing: normal; line-height: 1.2;"
            >Hubungi Sales</span
          >
        </div>

        <ul class="plan-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Aplikasi Android & iOS (Flutter Native)
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Custom UI/UX Desain (Premium)
          </li>
          <!-- <li>
            <svg class="check-icon" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"></polyline></svg>
            Integrasi Smart Feature (GIS/Peta/Booklet)
          </li> -->
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Dashboard Admin & API Super Cepat
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Bantuan Rilis di Play Store & App Store
          </li>
        </ul>

        <a href="#contact" class="btn btn-pricing-action btn-cyan-glow"
          >Hubungi Developer</a
        >
      </div>

      <!-- Plan 3: SaaS & Promotion Agency -->
      <div class="pricing-card">
        <div class="card-badge purple">SaaS & Agensi Promosi</div>
        <h3 class="plan-name">SaaS Platform & Growth</h3>
        <p class="plan-desc">
          Manajemen infrastruktur SaaS cloud dan agensi promosi produk otomatis.
        </p>

        <div class="plan-price">
          <span
            class="price-val"
            style="font-size: 28px; letter-spacing: normal; line-height: 1.2;"
            >Hubungi Sales</span
          >
        </div>

        <ul class="plan-features">
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Pembuatan Dashboard SaaS Kustom
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Manajemen Cloud Storage S3 Console
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Otomatisasi Funnel Promosi Produk
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Kampanye Iklan Berbayar Bulanan
          </li>
          <li>
            <svg class="check-icon" viewBox="0 0 24 24"
              ><polyline points="20 6 9 17 4 12"></polyline></svg
            >
            Laporan Analitik & Optimasi Konversi
          </li>
        </ul>

        <a href="#contact" class="btn btn-pricing-action">Hubungi Sales</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pricing-section {
    background-color: #080711;
    padding: 120px 0;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .section-header {
    max-width: 700px;
    margin: 0 auto 60px;
  }

  .section-title {
    color: #ffffff;
    font-size: 38px;
    font-weight: 800;
    line-height: 1.25;
    margin-bottom: 20px;
  }

  .gradient-text {
    background: linear-gradient(135deg, #6366f1, #06b6d4, #10b981);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .section-subtitle {
    color: #94a3b8;
    font-size: 16px;
    line-height: 1.6;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    align-items: center;
  }

  .pricing-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 24px;
    padding: 40px 32px;
    transition: all 0.3s ease;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .pricing-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(255, 255, 255, 0.15);
  }

  /* Recommended card special glow styling */
  .pricing-card.highlighted {
    background: rgba(10, 9, 21, 0.9);
    border: 2px solid #06b6d4;
    box-shadow: 0 20px 45px rgba(6, 182, 212, 0.15);
    padding: 48px 32px;
    z-index: 10;
  }

  .pricing-card.highlighted:hover {
    box-shadow: 0 25px 50px rgba(6, 182, 212, 0.25);
  }

  .recommended-ribbon {
    position: absolute;
    top: 20px;
    right: 20px;
    background: #06b6d4;
    color: #ffffff;
    font-size: 10px;
    font-weight: 800;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 1px;
  }

  .card-badge {
    align-self: flex-start;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.2);
    margin-bottom: 24px;
    letter-spacing: 0.5px;
  }

  .card-badge.cyan {
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border-color: rgba(6, 182, 212, 0.2);
  }

  .card-badge.purple {
    background: rgba(99, 102, 241, 0.1);
    color: #6366f1;
    border-color: rgba(99, 102, 241, 0.2);
  }

  .plan-name {
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 12px;
  }

  .plan-desc {
    color: #64748b;
    font-size: 14px;
    line-height: 1.5;
    margin-bottom: 28px;
    min-height: 42px;
  }

  .plan-price {
    margin-bottom: 32px;
    display: flex;
    align-items: baseline;
    gap: 6px;
  }

  .currency {
    font-size: 14px;
    color: #94a3b8;
    font-weight: 500;
  }

  .price-val {
    font-size: 38px;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -1px;
  }

  .period {
    font-size: 14px;
    color: #64748b;
  }

  .plan-features {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-bottom: 40px;
    flex-grow: 1;
  }

  .plan-features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #cbd5e1;
    font-weight: 500;
  }

  .check-icon {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: #10b981;
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  .pricing-card.highlighted .check-icon {
    stroke: #06b6d4;
  }

  .btn-pricing-action {
    width: 100%;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    color: #ffffff;
    font-size: 14px;
    font-weight: 700;
    padding: 14px;
    border-radius: 50px;
    text-align: center;
    transition: all 0.3s ease;
  }

  .btn-pricing-action:hover {
    background: #ffffff;
    color: #080711;
    transform: translateY(-2px);
  }

  .btn-pricing-action.btn-cyan-glow {
    background: #06b6d4;
    color: #ffffff;
    border: none;
    box-shadow: 0 8px 20px rgba(6, 182, 212, 0.3);
  }

  .btn-pricing-action.btn-cyan-glow:hover {
    background: #22d3ee;
    box-shadow: 0 12px 25px rgba(6, 182, 212, 0.5);
    transform: translateY(-2px);
  }

  @media (max-width: 992px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      gap: 40px;
      max-width: 500px;
      margin: 0 auto;
    }

    .pricing-card.highlighted {
      padding: 40px 32px;
    }
  }
</style>

<script>
  // Tab Switcher Logic
  const tabBtns = document.querySelectorAll(
    ".tab-btn",
  ) as NodeListOf<HTMLButtonElement>;
  const tabContents = document.querySelectorAll(
    ".tab-content",
  ) as NodeListOf<HTMLDivElement>;

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tabId = btn.getAttribute("data-tab");

      tabBtns.forEach((b) => b.classList.remove("active"));
      tabContents.forEach((c) => c.classList.remove("active"));

      btn.classList.add("active");
      document.getElementById(`tab-${tabId}`)?.classList.add("active");
    });
  });

  // Phone App Simulator controls
  const btnShowSplash = document.getElementById(
    "btn-show-splash",
  ) as HTMLButtonElement | null;
  const btnShowBooklet = document.getElementById(
    "btn-show-booklet",
  ) as HTMLButtonElement | null;
  const screenSplash = document.getElementById(
    "screen-splash",
  ) as HTMLDivElement | null;
  const screenBooklet = document.getElementById(
    "screen-booklet",
  ) as HTMLDivElement | null;

  btnShowSplash?.addEventListener("click", () => {
    btnShowSplash.classList.add("active");
    btnShowBooklet?.classList.remove("active");
    screenSplash?.classList.add("active");
    screenBooklet?.classList.remove("active");
  });

  btnShowBooklet?.addEventListener("click", () => {
    btnShowBooklet.classList.add("active");
    btnShowSplash?.classList.remove("active");
    screenBooklet?.classList.add("active");
    screenSplash?.classList.remove("active");
  });

  // SaaS Simulator controls
  const saasBtnSignin = document.getElementById(
    "saas-btn-signin",
  ) as HTMLButtonElement | null;
  const saasBtnDash = document.getElementById(
    "saas-btn-dash",
  ) as HTMLButtonElement | null;
  const saasBtnBuckets = document.getElementById(
    "saas-btn-buckets",
  ) as HTMLButtonElement | null;

  const saasScreenSignin = document.getElementById(
    "saas-screen-signin",
  ) as HTMLDivElement | null;
  const saasScreenDash = document.getElementById(
    "saas-screen-dash",
  ) as HTMLDivElement | null;
  const saasScreenBuckets = document.getElementById(
    "saas-screen-buckets",
  ) as HTMLDivElement | null;

  function activateSaasScreen(
    activeBtn: HTMLButtonElement,
    activeScreen: HTMLDivElement,
  ) {
    [saasBtnSignin, saasBtnDash, saasBtnBuckets].forEach((b) =>
      b?.classList.remove("active"),
    );
    [saasScreenSignin, saasScreenDash, saasScreenBuckets].forEach((s) =>
      s?.classList.remove("active"),
    );

    activeBtn.classList.add("active");
    activeScreen.classList.add("active");
  }

  saasBtnSignin?.addEventListener(
    "click",
    () =>
      saasScreenSignin && activateSaasScreen(saasBtnSignin, saasScreenSignin),
  );
  saasBtnDash?.addEventListener(
    "click",
    () => saasScreenDash && activateSaasScreen(saasBtnDash, saasScreenDash),
  );
  saasBtnBuckets?.addEventListener(
    "click",
    () =>
      saasScreenBuckets &&
      activateSaasScreen(saasBtnBuckets, saasScreenBuckets),
  );

  // SaaS Platform Switcher (GravSpace vs Nursynapse)
  const saasPlatBtns = document.querySelectorAll(
    ".saas-plat-btn",
  ) as NodeListOf<HTMLButtonElement>;
  const saasLayouts = document.querySelectorAll(
    ".saas-showcase-layout",
  ) as NodeListOf<HTMLDivElement>;

  saasPlatBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const platformId = btn.getAttribute("data-saas-platform");

      saasPlatBtns.forEach((b) => b.classList.remove("active"));
      saasLayouts.forEach((l) => l.classList.remove("active"));

      btn.classList.add("active");
      document
        .getElementById(`saas-${platformId}-layout`)
        ?.classList.add("active");
    });
  });
</script>

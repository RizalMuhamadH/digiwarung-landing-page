---
import { Image } from "astro:assets";
import bekasiSplashImg from "../../assets/saas/bekasi_splash.jpg";
import bekasiBookletImg from "../../assets/saas/bekasi_booklet.jpeg";
import gravspaceSigninImg from "../../assets/saas/fireshot_signin.png";
import gravspaceDashboardImg from "../../assets/saas/fireshot_dashboard.png";
import gravspaceBucketsImg from "../../assets/saas/fireshot_buckets.png";
import nursynapseImg from "../../assets/saas/nursynapse_pilot_2026.png";
---

<section class="portfolio-section" id="portfolio">
  <div class="container">
    <div class="section-header text-center">
      <h2 class="section-title">
        Portofolio Produk & <br />
        <span class="gradient-text">Studi Kasus Klien</span>
      </h2>
      <p class="section-subtitle">
        Jelajahi ekosistem digital yang telah kami rancang dan kembangkan, mulai
        dari portal berita jutaan pembaca hingga platform SaaS berskala
        korporat.
      </p>
    </div>

    <!-- Portfolio Tabs Selector -->
    <div class="portfolio-tabs">
      <!-- <button class="tab-btn active" data-tab="websites">
        <svg class="tab-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        <span>Portal Media & Web (5 Platform)</span>
      </button> -->
      <button class="tab-btn active" data-tab="mobile">
        <svg
          class="tab-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line
            x1="12"
            y1="18"
            x2="12.01"
            y2="18"></line></svg
        >
        <span>Aplikasi Mobile (WOW Bekasi)</span>
      </button>
      <button class="tab-btn" data-tab="saas">
        <svg
          class="tab-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect><line
            x1="2"
            y1="20"
            x2="22"
            y2="20"></line><line x1="12" y1="17" x2="12" y2="20"></line></svg
        >
        <span>SaaS & Platform Riset (2 Platform)</span>
      </button>
    </div>

    <!-- Tab Contents -->
    <div class="portfolio-container">
      <!-- TAB 1: WEBSITE PORTFOLIO -->
      <!-- <div class="tab-content active" id="tab-websites">
        <div class="websites-grid">
          <a href="https://www.ayobandung.id/" target="_blank" class="web-portfolio-card">
